{
  "name": "slopcop",
  "displayName": "slopcop",
  "description": "Deterministic linting for slop in code, comments, and documentation.",
  "version": "0.3.1",
  "publisher": "JGalego",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/slopcop",
    "directory": "editors/vscode"
  },
  "homepage": "https://slopcop.me",
  "bugs": "https://github.com/JGalego/slopcop/issues",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "linter",
    "documentation",
    "code quality"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "slopcop.restart",
        "title": "Restart Language Server",
        "category": "slopcop"
      },
      {
        "command": "slopcop.refresh",
        "title": "Scan Workspace",
        "category": "slopcop",
        "icon": "$(refresh)"
      },
      {
        "command": "slopcop.groupByRule",
        "title": "Group by Rule",
        "category": "slopcop",
        "icon": "$(list-tree)"
      },
      {
        "command": "slopcop.groupByFile",
        "title": "Group by File",
        "category": "slopcop",
        "icon": "$(file)"
      },
      {
        "command": "slopcop.reportFalsePositive",
        "title": "Report False Positive",
        "category": "slopcop",
        "icon": "$(thumbsdown)"
      },
      {
        "command": "slopcop.nominate",
        "title": "Nominate for Most Wanted",
        "category": "slopcop",
        "icon": "$(star-empty)"
      },
      {
        "command": "slopcop.reportMissedSlop",
        "title": "Report Missed Slop",
        "category": "slopcop",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "slopocop.reportMisfire",
        "title": "Report Misfire",
        "category": "slopocop",
        "icon": "$(thumbsdown)"
      },
      {
        "command": "slopocop.reportEscapedSuspect",
        "title": "Report Escaped Suspect",
        "category": "slopocop",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "slopocop.directives",
        "title": "Read the Directives",
        "category": "slopocop"
      },
      {
        "command": "slopcop.reportBug",
        "title": "Report a Bug",
        "category": "slopcop"
      },
      {
        "command": "slopcop.requestFeature",
        "title": "Request a Feature",
        "category": "slopcop"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "slopcop",
          "title": "slopcop",
          "icon": "images/activity.svg"
        },
        {
          "id": "slopocop",
          "title": "slopocop",
          "icon": "images/activity-slopocop.svg"
        }
      ]
    },
    "views": {
      "slopcop": [
        {
          "id": "slopcop.findings",
          "name": "Findings",
          "icon": "images/activity.svg",
          "contextualTitle": "slopcop",
          "when": "!config.slopcop.slopocop"
        }
      ],
      "slopocop": [
        {
          "id": "slopocop.findings",
          "name": "Suspects",
          "icon": "images/activity-slopocop.svg",
          "contextualTitle": "slopocop",
          "when": "config.slopcop.slopocop"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "slopcop.findings",
        "contents": "Open a folder to scan it for slop.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "slopcop.findings",
        "contents": "No slop detected. Suspiciously competent.\n[Scan Again](command:slopcop.refresh)",
        "when": "slopcop.clean"
      },
      {
        "view": "slopocop.findings",
        "contents": "Open a folder to put slopocop on patrol.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "slopocop.findings",
        "contents": "Area secure. Thank you for your cooperation.\n[Sweep Again](command:slopcop.refresh)",
        "when": "slopcop.clean"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "slopcop.refresh",
          "when": "view =~ /^slopo?cop\\.findings$/",
          "group": "navigation@1"
        },
        {
          "command": "slopcop.groupByRule",
          "when": "view =~ /^slopo?cop\\.findings$/ && slopcop.groupBy != rule",
          "group": "navigation@2"
        },
        {
          "command": "slopcop.groupByFile",
          "when": "view =~ /^slopo?cop\\.findings$/ && slopcop.groupBy == rule",
          "group": "navigation@2"
        },
        {
          "command": "slopcop.reportMissedSlop",
          "when": "view =~ /^slopo?cop\\.findings$/ && !config.slopcop.slopocop",
          "group": "navigation@3"
        },
        {
          "command": "slopocop.reportEscapedSuspect",
          "when": "view =~ /^slopo?cop\\.findings$/ && config.slopcop.slopocop",
          "group": "navigation@3"
        },
        {
          "command": "slopcop.reportBug",
          "when": "view =~ /^slopo?cop\\.findings$/",
          "group": "feedback@1"
        },
        {
          "command": "slopcop.requestFeature",
          "when": "view =~ /^slopo?cop\\.findings$/",
          "group": "feedback@2"
        }
      ],
      "view/item/context": [
        {
          "command": "slopcop.reportFalsePositive",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding && !config.slopcop.slopocop",
          "group": "inline@1"
        },
        {
          "command": "slopocop.reportMisfire",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding && config.slopcop.slopocop",
          "group": "inline@1"
        },
        {
          "command": "slopcop.nominate",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "slopcop.reportFalsePositive",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding && !config.slopcop.slopocop",
          "group": "feedback@1"
        },
        {
          "command": "slopocop.reportMisfire",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding && config.slopcop.slopocop",
          "group": "feedback@1"
        },
        {
          "command": "slopcop.nominate",
          "when": "view =~ /^slopo?cop\\.findings$/ && viewItem == finding",
          "group": "feedback@2"
        }
      ],
      "editor/context": [
        {
          "command": "slopcop.reportFalsePositive",
          "when": "slopcop.onFinding && !config.slopcop.slopocop",
          "group": "slopcop@1"
        },
        {
          "command": "slopocop.reportMisfire",
          "when": "slopcop.onFinding && config.slopcop.slopocop",
          "group": "slopcop@1"
        },
        {
          "command": "slopcop.nominate",
          "when": "slopcop.onFinding",
          "group": "slopcop@2"
        },
        {
          "command": "slopcop.reportMissedSlop",
          "when": "resourceScheme == file && !config.slopcop.slopocop",
          "group": "slopcop@3"
        },
        {
          "command": "slopocop.reportEscapedSuspect",
          "when": "resourceScheme == file && config.slopcop.slopocop",
          "group": "slopcop@3"
        }
      ],
      "commandPalette": [
        {
          "command": "slopcop.groupByRule",
          "when": "false"
        },
        {
          "command": "slopcop.groupByFile",
          "when": "false"
        },
        {
          "command": "slopocop.reportMisfire",
          "when": "config.slopcop.slopocop"
        },
        {
          "command": "slopocop.reportEscapedSuspect",
          "when": "config.slopcop.slopocop"
        },
        {
          "command": "slopocop.directives",
          "when": "config.slopcop.slopocop"
        }
      ]
    },
    "configuration": {
      "title": "slopcop",
      "properties": {
        "slopcop.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `slopcop` executable. When empty, the extension uses the binary bundled with it, or `slopcop` on `PATH`."
        },
        "slopcop.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages exchanged with the language server in the slopcop output channel."
        },
        "slopcop.slopocop": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable slopocop, an opt-in persona: a status bar patrol count, the Suspects view in his own Activity Bar container, a Directives walkthrough, and renamed report commands. Findings and rules do not change."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "slopocop",
        "title": "slopocop Directives",
        "description": "Four directives for working with slopocop.",
        "when": "config.slopcop.slopocop",
        "steps": [
          {
            "id": "scan",
            "title": "Directive 1: Serve the codebase",
            "description": "Put slopocop on patrol across the workspace.\n[Scan the workspace](command:slopcop.refresh)",
            "media": {
              "markdown": "walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:slopcop.refresh"
            ]
          },
          {
            "id": "review",
            "title": "Directive 2: Protect the reader",
            "description": "Review suspects and the rules they broke.\n[Open the Suspects view](command:workbench.view.extension.slopocop)",
            "media": {
              "markdown": "walkthrough/review.md"
            },
            "completionEvents": [
              "onView:slopocop.findings"
            ]
          },
          {
            "id": "rules",
            "title": "Directive 3: Uphold the rules",
            "description": "Tune severities, and suppress deliberate findings with a reason.",
            "media": {
              "markdown": "walkthrough/rules.md"
            }
          },
          {
            "id": "classified",
            "title": "Directive 4: Classified",
            "description": "Clearance required.",
            "media": {
              "markdown": "walkthrough/classified.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
